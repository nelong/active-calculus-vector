    <statement><p>Find the cross product <m>\mathbf c \times \mathbf d</m> where
<m>\mathbf c = 4\boldsymbol{j}+4\boldsymbol{k}</m> and
<m>\mathbf d =  4\boldsymbol{i}-\boldsymbol{j}-5\boldsymbol{k}</m>.</p>
<p><m>\mathbf c \times \mathbf d =</m>
<fillin characters="20" name="AnSwEr0001"/></p>
</statement>
    <answer>
      <p>
        <m>-16\boldsymbol{i}+16\boldsymbol{j}-16\boldsymbol{k}</m>
      </p>
    </answer>
