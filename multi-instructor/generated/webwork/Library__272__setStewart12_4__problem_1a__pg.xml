    <statement><p>Find the cross product <m>\mathbf c \times \mathbf d</m> where
<m>\mathbf c = 2\boldsymbol{i}-3\boldsymbol{j}+3\boldsymbol{k}</m> and
<m>\mathbf d =  \boldsymbol{i}-4\boldsymbol{j}+2\boldsymbol{k}</m>.</p>
<p><m>\mathbf c \times \mathbf d =</m>
<fillin characters="20" name="AnSwEr0001"/></p>
</statement>
