  <static seed="105" source="Library/272/setStewart12_5/problem_11.pg">
    <statement><p>Find an equation of a plane through the point (1, 1, 0)
which is parallel to the plane <m>-5x  - 4y + 2z = -8</m> in
which the coefficient of x is -5.</p>
<p><fillin characters="60" name="AnSwEr0001"/> = 0.</p>
</statement>
    <answer>
      <p>
        <m>-5\mathopen{}\left(x-1\right)+\left(-4\right)\mathopen{}\left(y-1\right)+2\mathopen{}\left(z-0\right)</m>
      </p>
    </answer>
