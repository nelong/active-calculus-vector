    <statement><p>Find the velocity and position vectors of a particle with acceleration
<m>\mathbf a(t) = \langle 0,0,2 \rangle</m>, and initial conditions
<m>\mathbf v(0) = \langle -5, -4, 3 \rangle</m> and 
<m>\mathbf r(0) = \langle 4, -3, -1 \rangle</m>.</p>
<p><m>\mathbf v(t) = \langle</m><fillin characters="20" name="AnSwEr0001"/>, <fillin characters="20" name="AnSwEr0002"/>,<fillin characters="20" name="AnSwEr0003"/><m>\rangle</m></p>
<p><m>\mathbf r(t) = \langle</m><fillin characters="20" name="AnSwEr0004"/>, <fillin characters="20" name="AnSwEr0005"/>,<fillin characters="20" name="AnSwEr0006"/><m>\rangle</m></p>
</statement>
    <answer>
      <p>
        <m>-5</m>
      </p>
    </answer>
    <answer>
      <p>
        <m>-4</m>
      </p>
    </answer>
    <answer>
      <p>
        <m>2t+3</m>
      </p>
    </answer>
    <answer>
      <p>
        <m>-5t+4</m>
      </p>
    </answer>
    <answer>
      <p>
        <m>-4t+\left(-3\right)</m>
      </p>
    </answer>
    <answer>
      <p>
        <m>\frac{2tt}{2}+3t+\left(-1\right)</m>
      </p>
    </answer>
