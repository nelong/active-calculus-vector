    <statement><p>Find the partial derivatives of the function
<me>w = \sqrt{5 r^2 + 4 s^2 + 4 t^2}</me></p>
<p><m>\frac{\partial w}{\partial r} =</m> <fillin characters="60" name="AnSwEr0001"/></p>
<p><m>\frac{\partial w}{\partial s} =</m> <fillin characters="60" name="AnSwEr0002"/></p>
<p><m>\frac{\partial w}{\partial t} =</m> <fillin characters="60" name="AnSwEr0003"/></p>
</statement>
    <answer>
      <p>
        <m>\frac{5r}{\sqrt{5r^{2}+4s^{2}+4t^{2}}}</m>
      </p>
    </answer>
    <answer>
      <p>
        <m>\frac{4s}{\sqrt{5r^{2}+4s^{2}+4t^{2}}}</m>
      </p>
    </answer>
    <answer>
      <p>
        <m>\frac{4t}{\sqrt{5r^{2}+4s^{2}+4t^{2}}}</m>
      </p>
    </answer>
