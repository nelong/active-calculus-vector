    <statement><p>If 
 <m>\mathbf{r}(t)= \cos(-t)\mathbf{i}+\sin( -t)\mathbf{j} - 4t
 \mathbf{k}</m></p>
<p>compute <m>\mathbf{r}'(t)</m>= <fillin characters="15" name="AnSwEr0001"/> <m>\mathbf{i}+</m>
 <fillin characters="15" name="AnSwEr0002"/><m>\mathbf{j}+</m> <fillin characters="15" name="AnSwEr0003"/> <m>{\mathbf{k}}</m></p>
<p>and <m>\int{\mathbf{r}}(t)\, dt</m>= <fillin characters="15" name="AnSwEr0004"/> <m>\mathbf{i}+</m>
 <fillin characters="15" name="AnSwEr0005"/><m>\mathbf{j}+</m> <fillin characters="15" name="AnSwEr0006"/> <m>\mathbf{k}
+ \mathbf{C}</m></p>
<p>with <m>\mathbf{C}</m> a constant vector.</p>
</statement>
    <answer>
      <p>
        <m>-\left(-1\right)\sin\mathopen{}\left(-t\right)</m>
      </p>
    </answer>
    <answer>
      <p>
        <m>-1\cos\mathopen{}\left(-t\right)</m>
      </p>
    </answer>
    <answer>
      <p>
        <m>2\cdot \left(-2\right)</m>
      </p>
    </answer>
    <answer>
      <p>
        <m>\frac{1}{-1}\sin\mathopen{}\left(-t\right)</m>
      </p>
    </answer>
    <answer>
      <p>
        <m>\frac{-1}{-1}\cos\mathopen{}\left(-t\right)</m>
      </p>
    </answer>
    <answer>
      <p>
        <m>-2t^{2}</m>
      </p>
    </answer>
