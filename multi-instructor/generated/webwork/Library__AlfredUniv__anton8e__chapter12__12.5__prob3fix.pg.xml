  <static seed="137" source="Library/AlfredUniv/anton8e/chapter12/12.5/prob3fix.pg">
    <statement><p>Give a vector parametric equation for the line
that passes through the point <m>\left(1,-4,0\right)</m>, parallel
to the line parametrized by <m>\left\lt -4-3t,-4t,4-5t\right&gt;</m>:
<CENTER/></p>
<p><m>L(t)</m> = <fillin characters="40" name="AnSwEr0001"/>.
</p>
</statement>
    <answer>
      <p>
        <m>\left&lt;1,-4,0\right&gt;+t\mathopen{}\left&lt;-3,-4,-5\right&gt;</m>
      </p>
    </answer>
