</li>
<li>
<m>\vec{F} = \displaystyle \left\langle \frac{-x}{x^2+y^2}, \ \frac{-y}{x^2+y^2} \right\rangle</m>
</li>
<li>
<m>\vec{F} = \langle -x, -y \rangle</m>
</li>
</ol></cell>
