    <statement><p>Match the following vector fields with the verbal descriptions of the level
curves or level surfaces to which they are perpendicular by putting the letter
of the verbal description to the left of the number of the vector field.</p>
<p><ol>
<li>
<p><m>\mathbf F = x\mathbf i + y\mathbf j</m></p>
</li>
<li>
<p><m>\mathbf F = 2x\mathbf i + y\mathbf j</m></p>
</li>
<li>
<p><m>\mathbf F = 2\mathbf i + \mathbf j + \mathbf k</m></p>
</li>
<li>
<p><m>\mathbf F = y\mathbf i + x\mathbf j</m></p>
</li>
<li>
<p><m>\mathbf F = -y\mathbf i + x\mathbf j</m></p>
</li>
<li>
<p><m>\mathbf F = x\mathbf i + y\mathbf j - z\mathbf k</m></p>
</li>
<li>
<p><m>\mathbf F = 2x\mathbf i + y\mathbf j + z\mathbf k</m></p>
</li>
<li>
<p><m>\mathbf F = x\mathbf i + y\mathbf j + z\mathbf k</m></p>
</li>
<li>
<p><m>\mathbf F = x\mathbf i - y\mathbf j</m></p>
</li>
<li>
<p><m>\mathbf F = x\mathbf i + y\mathbf j - \mathbf k</m></p>
</li>
<li>
<p><m>\mathbf F = 2\mathbf i + \mathbf j</m></p>
</li>
</ol></p>
<p><ol label="A.">
<li>
<p>hyperboloids</p>
</li>
<li>
<p>ellipsoids</p>
</li>
<li>
<p>spheres</p>
</li>
<li>
<p>lines</p>
</li>
<li>
<p>circles</p>
</li>
<li>
<p>paraboloids</p>
</li>
<li>
<p>hyperbolas</p>
</li>
<li>
<p>planes</p>
</li>
<li>
<p>ellipses</p>
</li>
</ol></p>
</statement>
