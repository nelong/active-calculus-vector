    <statement><p>Find the first partial derivatives of the function <m>\displaystyle u(r,t) = 3 \sin(r \cos t)).</m></p>
<p><alert> 1.</alert> <m>\displaystyle u_r(r,t) =</m> <fillin characters="30" name="AnSwEr0001"/></p>
<p><alert> 2.</alert> <m>\displaystyle u_t(r,t) =</m> <fillin characters="30" name="AnSwEr0002"/></p>
</statement>
    <answer>
      <p>
        <m>3\cos\mathopen{}\left(r\cos\mathopen{}\left(t\right)\right)\cos\mathopen{}\left(t\right)</m>
      </p>
    </answer>
    <answer>
      <p>
        <m>-3r\cos\mathopen{}\left(r\cos\mathopen{}\left(t\right)\right)\sin\mathopen{}\left(t\right)</m>
      </p>
    </answer>
