    <statement><p>Convert from polar to rectangular coordinates:</p>
<p><m>\mathbf{(a)}\quad(7,\frac{3\pi}{2})\quad\Rightarrow_{(x,y)}\quad</m>(<fillin characters="5" name="AnSwEr0001"/>,<fillin characters="5" name="AnSwEr0002"/>)</p>
<p><m>\mathbf{(b)}\quad(5,\frac{\pi}{4})\quad\Rightarrow_{(x,y)}\quad</m>(<fillin characters="5" name="AnSwEr0003"/>,<fillin characters="5" name="AnSwEr0004"/>)</p>
<p><m>\mathbf{(c)}\quad(5,\frac{\pi}{3})\quad\Rightarrow_{(x,y)}\quad</m>(<fillin characters="5" name="AnSwEr0005"/>,<fillin characters="5" name="AnSwEr0006"/>)</p>
</statement>
