    <statement><p>Let <m>\mathbf{v} =
\left\lt  \begin{array}{ccc} 3, \amp  1, \amp  1  \end{array} \right&gt;</m></p>
<p>Calculate:</p>
<p><m>\mathbf{v}\times\bf{i} = \left\lt  \right.</m> <fillin characters="2" name="AnSwEr0001"/>,<fillin characters="2" name="AnSwEr0002"/>,<fillin characters="2" name="AnSwEr0003"/> <m>\left.\right&gt;</m></p>
<p><m>\mathbf{v}\times\bf{j} = \left\lt  \right.</m> <fillin characters="2" name="AnSwEr0004"/>,<fillin characters="2" name="AnSwEr0005"/>,<fillin characters="2" name="AnSwEr0006"/> <m>\left.\right&gt;</m></p>
<p><m>\mathbf{v}\times\bf{k} = \left\lt  \right.</m> <fillin characters="2" name="AnSwEr0007"/>,<fillin characters="2" name="AnSwEr0008"/>,<fillin characters="2" name="AnSwEr0009"/> <m>\left.\right&gt;</m></p>
</statement>
    <answer>
      <p>
        <m>0</m>
      </p>
    </answer>
