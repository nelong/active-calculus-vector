    <statement><p>Calculate <m>\bf{v} \times \bf{w}</m>:</p>
<p><m>\mathbf{v}=\left\lt 4,3,7\right&gt;,\quad \mathbf{w}=\left\lt 7,8,1\right&gt;</m></p>
<p><m>\mathbf{v}\times \mathbf{w} =</m> <fillin characters="20" name="AnSwEr0001"/></p>
</statement>
    <answer>
      <p>
        <m>-53\boldsymbol{i}+45\boldsymbol{j}+11\boldsymbol{k}</m>
      </p>
    </answer>
    <solution><m>\left|\begin{array}{ccc}
 \boldsymbol{i} \amp  \boldsymbol{j} \amp  \boldsymbol{k} \\
 4 \amp  3 \amp  7 \\
 7 \amp  8 \amp  1 
\end{array} \right|
= 
\left| \begin{array}{ccc}
 3 \amp  7 \\
 8 \amp  1 
\end{array} \right| \boldsymbol{i}
-  \left| \begin{array}{ccc}
 4 \amp  7 \\
 7 \amp  1  \end{array} \right| \boldsymbol{j}
+ \left| \begin{array}{ccc}
 4 \amp  3 \\
 7 \amp  8  \end{array} \right| \boldsymbol{k}</m>





<m>\qquad = \left(3\cdot 1-7\cdot 8\right) \boldsymbol{i} - \left(4\cdot 1-7\cdot 7\right) \boldsymbol{j} + \left(4\cdot 8-3\cdot 7\right) \boldsymbol{k}</m>





<m>\qquad = -53\boldsymbol{i}+45\boldsymbol{j}+11\boldsymbol{k}</m>



</solution>
