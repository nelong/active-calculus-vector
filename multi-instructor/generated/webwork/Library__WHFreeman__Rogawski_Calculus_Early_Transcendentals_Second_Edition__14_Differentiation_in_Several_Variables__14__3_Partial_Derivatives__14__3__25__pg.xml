    <statement><p>Compute the partial derivatives:</p>
<p><m>z=\ln\mathopen{}\left(x^{5}+y^{7}\right)</m></p>
<p><m>\frac{\partial{z}}{\partial{x}}=</m> <fillin characters="20" name="AnSwEr0001"/></p>
<p><m>\frac{\partial{z}}{\partial{y}}=</m> <fillin characters="20" name="AnSwEr0002"/></p>
</statement>
    <answer>
      <p>
        <m>\frac{5x^{4}}{x^{5}+y^{7}}</m>
      </p>
    </answer>
    <answer>
      <p>
        <m>\frac{7y^{6}}{x^{5}+y^{7}}</m>
      </p>
    </answer>
    <solution><m>\frac{\partial{z}}{\partial{x}}=\frac{1}{\left(x^{5}+y^{7}\right)}\frac{\partial}{\partial{x}}\left(x^{5}+y^{7}\right)=\frac{5x^{4}}{x^{5}+y^{7}}</m>



<m>\frac{\partial{z}}{\partial{y}}=\frac{1}{\left(x^{5}+y^{7}\right)} \frac{\partial}{\partial{y}}\left(x^{5}+y^{7}\right)=\frac{7y^{6}}{x^{5}+y^{7}}</m>





</solution>
