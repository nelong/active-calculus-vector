  <static seed="633" source="Library/WHFreeman/Rogawski_Calculus_Early_Transcendentals_Second_Edition/15_Multiple_Integration/15.6_Change_of_Variables/15.6.13.pg">
    <statement><p>Compute the Jacobian of :
<me>\Phi(u,v)=(-\left(8u+9v\right),3u+5v)</me></p>
<p><m>\mathrm{Jac}(\Phi)=</m> <fillin characters="20" name="AnSwEr0001"/></p>
</statement>
    <answer>
      <p>
        <m>-13</m>
      </p>
    </answer>
    <solution><me>\mathrm{Jac}(\Phi)=\frac{\partial ( x,y )}{\partial ( u,v )}=\left|\begin{array}{rr} \left(-8\right) \amp  \left(-9\right) \\
3 \amp  5 \end{array}\right|=\left(-8\right) \cdot 5 -\left(-9\right)\cdot 3=-13</me>



</solution>
