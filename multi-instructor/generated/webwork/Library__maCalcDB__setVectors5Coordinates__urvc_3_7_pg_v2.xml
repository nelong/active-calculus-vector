    <statement><p>Match the given equation with the verbal description of the surface:
<ol label="A.">
<li>
<p>Cone</p>
</li>
<li>
<p>Half plane</p>
</li>
<li>
<p>Circular Cylinder</p>
</li>
<li>
<p>Plane</p>
</li>
<li>
<p>Elliptic or Circular Paraboloid</p>
</li>
<li>
<p>Sphere</p>
</li>
</ol>
<ol>
<li>
<p><m>r^2 + z^2 =16</m></p>
</li>
<li>
<p><m>r =4</m></p>
</li>
<li>
<p><m>\rho = 4</m></p>
</li>
<li>
<p><m>\phi = \frac{\pi}{3}</m></p>
</li>
<li>
<p><m>z = r^2</m></p>
</li>
<li>
<p><m>\rho \cos(\phi )= 4</m></p>
</li>
<li>
<p><m>\theta = \frac{\pi}{3}</m></p>
</li>
<li>
<p><m>\rho = 2\cos(\phi )</m></p>
</li>
<li>
<p><m>r = 2\cos(\theta )</m></p>
</li>
</ol></p>
</statement>
