    <statement><p>Find the differential of the function <m>w = x \sin \left( 3 y z^{1} \right)</m>.</p>
<p>dw = <fillin characters="20" name="AnSwEr0001"/> dx + <fillin characters="20" name="AnSwEr0002"/> dy + <fillin characters="20" name="AnSwEr0003"/> dz</p>
<p>Note: Your answers should be expressions of x, y and z; e.g. <lq/>3xy + 4z<rq/></p>
</statement>
    <answer>
      <p>
        <m>\sin\mathopen{}\left(3yz^{1}\right)</m>
      </p>
    </answer>
    <answer>
      <p>
        <m>3xz^{1}\cos\mathopen{}\left(3yz^{1}\right)</m>
      </p>
    </answer>
    <answer>
      <p>
        <m>3xyz^{0}\cos\mathopen{}\left(3yz^{1}\right)</m>
      </p>
    </answer>
