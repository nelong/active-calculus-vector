<p><m>\mathbf a = \langle -5, 4, -1 \rangle</m> and 
<m>\mathbf b = \langle 20, -16, 4 \rangle</m> are</p>
<p><fillin characters="30" name="AnSwEr0003"/></p>
</statement>
