    <statement><p>Let <m>\mathbf{c}_1(t) = (e^{3t}, \sin(-t), -t^3)</m>, and
<m>\mathbf{c}_2(t) = (e^{t}, \cos(-4t), 3t^3)</m></p>
<p><m>\displaystyle \frac{d}{dt}\left[ \mathbf{c}_1(t) \cdot  \mathbf{c}_2(t)\right]  =</m><fillin characters="60" name="AnSwEr0001"/></p>
<p><m>\displaystyle \frac{d}{dt}\left[ \mathbf{c}_1(t) \times  \mathbf{c}_2(t)\right]  =</m>
    <fillin characters="60" name="AnSwEr0002"/><m>\mathbf{i}\ +</m></p>
<p><m>\hspace{1.15in}</m>    <fillin characters="60" name="AnSwEr0003"/><m>\mathbf{j}\ +</m></p>
<p><m>\hspace{1.15in}</m>  <fillin characters="60" name="AnSwEr0004"/><m>\mathbf{k}</m></p>
</statement>
    <answer>
      <p>
        <m>4\exp\mathopen{}\left(4t\right)+\left(-1\right)\cos\mathopen{}\left(-1t\right)\cos\mathopen{}\left(-4t\right)-\left(-4\right)\sin\mathopen{}\left(-1t\right)\sin\mathopen{}\left(-4t\right)+\left(-18\right)t^{5}</m>
      </p>
    </answer>
    <answer>
      <p>
        <m>9t^{2}\sin\mathopen{}\left(-1t\right)+\left(-3\right)t^{3}\cos\mathopen{}\left(-1t\right)+4t^{3}\sin\mathopen{}\left(-4t\right)-\left(-3\right)t^{2}\cos\mathopen{}\left(-4t\right)</m>
      </p>
    </answer>
    <answer>
      <p>
        <m>-3t^{2}\exp\mathopen{}\left(1t\right)+\left(-1\right)t^{3}\exp\mathopen{}\left(1t\right)-9t^{3}\exp\mathopen{}\left(3t\right)-9t^{2}\exp\mathopen{}\left(3t\right)</m>
      </p>
    </answer>
    <answer>
      <p>
        <m>4\exp\mathopen{}\left(3t\right)\sin\mathopen{}\left(-4t\right)+3\exp\mathopen{}\left(3t\right)\cos\mathopen{}\left(-4t\right)-\left(-1\right)\exp\mathopen{}\left(1t\right)\cos\mathopen{}\left(-1t\right)-1\exp\mathopen{}\left(1t\right)\sin\mathopen{}\left(-1t\right)</m>
      </p>
    </answer>
