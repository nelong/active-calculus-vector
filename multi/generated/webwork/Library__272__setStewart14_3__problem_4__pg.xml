  <static seed="321" source="Library/272/setStewart14_3/problem_4.pg">
    <statement><p>Find the partial derivatives of the function
<me>f(x,y) = \int_y^x \cos(1 t^2 + 2 t  - 5)\, dt</me></p>
<p><m>f_x(x,y) =</m><fillin characters="60" name="AnSwEr0001"/></p>
<p><m>f_y(x,y) =</m><fillin characters="60" name="AnSwEr0002"/></p>
</statement>
    <answer>
      <p>
        <m>\cos\mathopen{}\left(1x^{2}+2x+\left(-5\right)\right)</m>
      </p>
    </answer>
    <answer>
      <p>
        <m>-\cos\mathopen{}\left(1y^{2}+2y+\left(-5\right)\right)</m>
      </p>
    </answer>
