  <static seed="136" source="Library/AlfredUniv/anton8e/chapter12/12.5/parametriclinewithtimes.pg">
    <statement><p>Find the simplest vector parametric expression <m>\vec{r}(t)</m> for the line that passes through the points <m>P = \left(-5,4,0\right)</m> at time t = 2 and <m>Q = \left(-5,0,0\right)</m> at time t = 8.</p>
<p><m>\vec{r}(t) =</m> <fillin characters="40" name="AnSwEr0001"/></p>
</statement>
    <answer>
      <p>
        <m>\left(-5,4,0\right)+\left(t-2\right)\mathopen{}\left&lt;0,-0.666667,0\right&gt;</m>
      </p>
    </answer>
