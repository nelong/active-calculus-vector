    <statement><p>Find the derivative of the vector function</p>
<p><me>\mathbf r(t) = \ln(19 - t^2)\,\mathbf i + 
    \sqrt{2 + t}\, \mathbf j + 6 e^{-3 t}\,\mathbf k</me></p>
<p><m>\mathbf r'(t) = \langle</m>
<fillin characters="30" name="AnSwEr0001"/>,
<fillin characters="30" name="AnSwEr0002"/>,
<fillin characters="30" name="AnSwEr0003"/> <m>\rangle</m></p>
</statement>
    <answer>
      <p>
        <m>\frac{-2t}{19-tt}</m>
      </p>
    </answer>
    <answer>
      <p>
        <m>\frac{1}{2\sqrt{2+t}}</m>
      </p>
    </answer>
