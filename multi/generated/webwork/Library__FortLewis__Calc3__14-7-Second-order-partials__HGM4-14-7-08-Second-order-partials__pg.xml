  <static seed="350" source="Library/FortLewis/Calc3/14-7-Second-order-partials/HGM4-14-7-08-Second-order-partials.pg">
    <statement><p>Calculate all four second-order partial derivatives
of <m>\displaystyle f(x,y) = \sin\mathopen{}\left(\frac{5x}{y}\right)</m>.</p>
<p><m>f_{xx} \, (x,y) =</m> <fillin characters="80" name="AnSwEr0001"/></p>
<p><m>f_{xy} \, (x,y) =</m> <fillin characters="80" name="AnSwEr0002"/></p>
<p><m>f_{yx} \, (x,y) =</m> <fillin characters="80" name="AnSwEr0003"/></p>
<p><m>f_{yy} \, (x,y) =</m> <fillin characters="80" name="AnSwEr0004"/></p>
</statement>
    <answer>
      <p>
        <m>-\frac{5y}{y^{2}}\frac{5y}{y^{2}}\sin\mathopen{}\left(\frac{5x}{y}\right)</m>
      </p>
    </answer>
    <answer>
      <p>
        <m>\frac{5y^{2}-5y\cdot 2y}{\left(y^{2}\right)^{2}}\cos\mathopen{}\left(\frac{5x}{y}\right)+\frac{5y}{y^{2}}\frac{5x}{y^{2}}\sin\mathopen{}\left(\frac{5x}{y}\right)</m>
      </p>
    </answer>
    <answer>
      <p>
        <m>-\left(\frac{5y^{2}}{\left(y^{2}\right)^{2}}\cos\mathopen{}\left(\frac{5x}{y}\right)-\frac{5x}{y^{2}}\frac{5y}{y^{2}}\sin\mathopen{}\left(\frac{5x}{y}\right)\right)</m>
      </p>
    </answer>
    <answer>
      <p>
        <m>-\left(\frac{5x}{y^{2}}\frac{5x}{y^{2}}\sin\mathopen{}\left(\frac{5x}{y}\right)-\frac{5x\cdot 2y}{\left(y^{2}\right)^{2}}\cos\mathopen{}\left(\frac{5x}{y}\right)\right)</m>
      </p>
    </answer>
  </static>
