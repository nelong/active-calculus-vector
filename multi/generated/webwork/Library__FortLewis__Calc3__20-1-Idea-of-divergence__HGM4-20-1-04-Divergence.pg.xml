    <statement><p>Find the divergence of each of the following vector fields at all points where they are defined.</p>
<p>(a) <m>\displaystyle \mathrm{div} \left( \, \left(2x^{2}-\sin\mathopen{}\left(xz\right)\right)\boldsymbol{i}+2\boldsymbol{j}-\sin\mathopen{}\left(xz\right)\boldsymbol{k} \, \right) =</m> <fillin characters="40" name="AnSwEr0001"/></p>
<p>(b) <m>\displaystyle \mathrm{div} \left( \, 5e^{xy}\boldsymbol{i}+5\cos\mathopen{}\left(xy\right)\boldsymbol{j}+5e^{\ln\mathopen{}\left(x^{2}+y^{2}+4\right)}\boldsymbol{k} \, \right) =</m> <fillin characters="40" name="AnSwEr0002"/></p>
<p>(c) <m>\displaystyle \mathrm{div} \left( \, \frac{x}{\left(x^{2}+y^{2}+z^{2}\right)^{1.5}}\boldsymbol{i}+\frac{y}{\left(x^{2}+y^{2}+z^{2}\right)^{1.5}}\boldsymbol{j}+\frac{z}{\left(x^{2}+y^{2}+z^{2}\right)^{1.5}}\boldsymbol{k} \, \right) =</m> <fillin characters="40" name="AnSwEr0003"/></p>
</statement>
    <answer>
      <p>
        <m>4x-z\cos\mathopen{}\left(xz\right)-x\cos\mathopen{}\left(xz\right)</m>
      </p>
    </answer>
    <answer>
      <p>
        <m>5e^{xy}y-5\sin\mathopen{}\left(xy\right)x</m>
      </p>
    </answer>
    <answer>
      <p>
        <m>0</m>
      </p>
    </answer>
