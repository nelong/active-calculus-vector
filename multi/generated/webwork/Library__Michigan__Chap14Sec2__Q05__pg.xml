  <static seed="325" source="Library/Michigan/Chap14Sec2/Q05.pg">
    <statement><p>Find the partial derivatives indicated.
Assume the variables are restricted to a domain on 
which the function is defined.</p>
<p><me>z = \left(x^{5}+x-y\right)^{3}.</me></p>
<p><m>\frac{\partial z}{\partial x} =</m> <fillin characters="35" name="AnSwEr0001"/></p>
<p><m>\frac{\partial z}{\partial y} =</m> <fillin characters="35" name="AnSwEr0002"/></p>
</statement>
    <answer>
      <p>
        <m>3\mathopen{}\left(x^{5}+x-y\right)^{2}\mathopen{}\left(5x^{4}+1\right)</m>
      </p>
    </answer>
    <answer>
      <p>
        <m>-3\mathopen{}\left(x^{5}+x-y\right)^{2}</m>
      </p>
    </answer>
    <solution><me>\frac{\partial z}{\partial x}=\frac{\partial}{\partial
  x}\left[\left(x^{5}+x-y\right)^{3}\right] = 3\mathopen{}\left(x^{5}+x-y\right)^{2}\mathopen{}\left(5x^{4}+1\right).</me>

<me>\frac{\partial z}{\partial y}=\frac{\partial}{\partial 
  y}\left[\left(x^{5}+x-y\right)^{3}\right] = -3\mathopen{}\left(x^{5}+x-y\right)^{2}.</me>



</solution>
