</row>
<row>
<cell><m>63\vec i+39\vec j</m></cell>
<cell><m>34\vec i+3\vec j</m></cell>
<cell><m>59\vec i-44\vec j</m></cell>
</row>
<row>
<cell><m>25\vec i+18\vec j</m></cell>
