    <statement><p>Find the first partial derivatives of the function <m>\displaystyle f(x,y,z) = 2 x \sin(y-z).</m></p>
<p><alert> 1.</alert> <m>\displaystyle \frac{\partial f}{\partial x} =</m> <fillin characters="30" name="AnSwEr0001"/></p>
<p><alert> 2.</alert> <m>\displaystyle \frac{\partial f}{\partial y} =</m> <fillin characters="30" name="AnSwEr0002"/></p>
<p><alert> 3.</alert> <m>\displaystyle \frac{\partial f}{\partial z} =</m> <fillin characters="30" name="AnSwEr0003"/></p>
</statement>
    <answer>
      <p>
        <m>2\sin\mathopen{}\left(y-z\right)</m>
      </p>
    </answer>
    <answer>
      <p>
        <m>2x\cos\mathopen{}\left(y-z\right)</m>
      </p>
    </answer>
    <answer>
      <p>
        <m>-2x\cos\mathopen{}\left(y-z\right)</m>
      </p>
    </answer>
