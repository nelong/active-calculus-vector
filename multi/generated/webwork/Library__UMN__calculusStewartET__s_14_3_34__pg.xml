    <statement><p>Find the first partial derivatives of the function <m>\displaystyle w = 3 z e^{xyz}.</m></p>
<p><alert> 1.</alert> <m>\displaystyle \frac{\partial w}{\partial x} =</m> <fillin characters="30" name="AnSwEr0001"/></p>
<p><alert> 2.</alert> <m>\displaystyle \frac{\partial w}{\partial y} =</m> <fillin characters="30" name="AnSwEr0002"/></p>
<p><alert> 3.</alert> <m>\displaystyle \frac{\partial w}{\partial z} =</m> <fillin characters="30" name="AnSwEr0003"/></p>
</statement>
    <answer>
      <p>
        <m>3yz^{2}e^{xyz}</m>
      </p>
    </answer>
    <answer>
      <p>
        <m>3xz^{2}e^{xyz}</m>
      </p>
    </answer>
    <answer>
      <p>
        <m>3e^{xyz}+3xyze^{xyz}</m>
      </p>
    </answer>
