    <statement><p>Suppose <m>f(x,y)=xy-3</m>.  Compute the following values:</p>
<p><BLOCKQUOTE/></p>
<tabular>
<row>
<cell><m>f(x+4y,x-4y)</m></cell>
<cell><m>=</m></cell>
<cell><fillin characters="25" name="AnSwEr0001"/></cell>
</row>
<row>
<cell><m>f(xy,4x^2y^3)</m></cell>
<cell><m>=</m></cell>
<cell><fillin characters="25" name="AnSwEr0002"/></cell>
</row>
</tabular>
<p/>
</statement>
    <answer>
      <p>
        <m>\left(x+4y\right)\mathopen{}\left(x-4y\right)-3</m>
      </p>
    </answer>
    <answer>
      <p>
        <m>xy\cdot 4x^{2}y^{3}-3</m>
      </p>
    </answer>
