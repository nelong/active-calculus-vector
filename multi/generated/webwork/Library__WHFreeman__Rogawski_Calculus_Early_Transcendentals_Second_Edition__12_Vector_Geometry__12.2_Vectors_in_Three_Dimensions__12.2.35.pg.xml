    <statement><p>Find the vector parameterization for the line which passes through the origin and point <m>P = \left(4,-4,3\right)</m>.</p>
<p><var form="buttons">
<li>
<p><m>\left\lt \frac{t}{4},-\frac{t}{4},\frac{t}{3}\right&gt;</m></p>
</li>
<li>
<p><m>\left\lt 4+t,t-4,3+t\right&gt;</m></p>
</li>
<li>
<p><m>\left\lt 4t,-4t,3t\right&gt;</m></p>
</li>
<li>
<p><m>\left\lt 3t,t,5t\right&gt;</m></p>
</li>
</var></p>
</statement>
    <solution><m>v = \overrightarrow{OP} = P - 0 = \left\lt 4,-4,3\right&gt;</m>



<m>f(t) = 0 + t \cdot v = t \cdot \left\lt 4,-4,3\right&gt; = \left\lt 4t,-4t,3t\right&gt;</m>


</solution>
  </static>
