    </answer>
    <answer>
      <p>
        <m>0</m>
      </p>
    </answer>
    <solution><m>\mathbf{v}=-2 \mathbf{i}  - 4 \mathbf{j}  -  \mathbf{k}</m> and use the distributive law:



<m>\mathbf{v}\times\mathbf{i} = \left( -2 \mathbf{i}  - 4 \mathbf{j}  -  \mathbf{k} \right) \times \mathbf{i} = 
-2 \mathbf{i} \times \mathbf{i}  - 4 \mathbf{j}\times \mathbf{i}  -  \mathbf{k} \times \mathbf{i} = -2 \cdot\mathbf{ 0}  + 4 \mathbf{k}  -  \mathbf{j} = 
\left\lt  \begin{array}{ccc} 0, \amp  -1, \amp  4  \end{array} \right&gt;</m>



<m>\mathbf{v}\times\mathbf{j} = \left( -2 \mathbf{i}  - 4 \mathbf{j}  -  \mathbf{k} \right) \times \mathbf{j} = 
-2 \mathbf{i} \times \mathbf{j}  - 4 \mathbf{j}\times \mathbf{j}  -  \mathbf{k} \times \mathbf{j} = -2 \mathbf{k}  - 4 \cdot \mathbf{ 0}  +  \mathbf{i} = 
\left\lt  \begin{array}{ccc} 1, \amp  0, \amp  -2  \end{array} \right&gt;</m>



<m>\mathbf{v}\times\mathbf{k} = \left( -2 \mathbf{i}  - 4 \mathbf{j}  -  \mathbf{k} \right) \times \mathbf{k} = 
-2 \mathbf{i} \times \mathbf{k}  - 4 \mathbf{j}\times \mathbf{k}  -  \mathbf{k} \times \mathbf{k} =  + 2 \mathbf{j}  - 4 \mathbf{i}  + 1 \cdot \mathbf{ 0} = 
\left\lt  \begin{array}{ccc} -4, \amp  2, \amp  0  \end{array} \right&gt;</m>



</solution>
