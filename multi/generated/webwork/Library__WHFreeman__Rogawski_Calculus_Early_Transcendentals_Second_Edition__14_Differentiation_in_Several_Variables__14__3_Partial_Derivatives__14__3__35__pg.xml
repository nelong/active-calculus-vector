    <statement><p>Compute the partial derivatives:</p>
<p><m>z=\coth\mathopen{}\left(x^{5}y^{5}\right)</m></p>
<p><m>\frac{\partial{z}}{\partial{x}}=</m> <fillin characters="20" name="AnSwEr0001"/></p>
<p><m>\frac{\partial{z}}{\partial{y}}=</m> <fillin characters="20" name="AnSwEr0002"/></p>
</statement>
    <answer>
      <p>
        <m>5y^{5}x^{4}\mathopen{}\left(-\mathop{\rm csch}\nolimits^{2}\mathopen{}\left(x^{5}y^{5}\right)\right)</m>
      </p>
    </answer>
    <answer>
      <p>
        <m>5x^{5}y^{4}\mathopen{}\left(-\mathop{\rm csch}\nolimits^{2}\mathopen{}\left(x^{5}y^{5}\right)\right)</m>
      </p>
    </answer>
    <solution><m>\frac{\partial{z}}{\partial{x}}=-\mathop{\rm csch}\nolimits^{2}\mathopen{}\left(x^{5}y^{5}\right) \frac{\partial}{\partial{x}}\left(x^{5}y^{5}\right)=5y^{5}x^{4}\mathopen{}\left(-\mathop{\rm csch}\nolimits^{2}\mathopen{}\left(x^{5}y^{5}\right)\right)</m>



<m>\frac{\partial{z}}{\partial{y}}=-\mathop{\rm csch}\nolimits^{2}\mathopen{}\left(x^{5}y^{5}\right) \frac{\partial}{\partial{y}}\left(x^{5}y^{5}\right)=5x^{5}y^{4}\mathopen{}\left(-\mathop{\rm csch}\nolimits^{2}\mathopen{}\left(x^{5}y^{5}\right)\right)</m>





</solution>
