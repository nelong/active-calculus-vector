    <statement><p>Compute the Jacobian of :
<me>\Phi(u,v)=(8v-8u,-\left(2u+4v\right))</me></p>
<p><m>\mathrm{Jac}(\Phi)=</m> <fillin characters="20" name="AnSwEr0001"/></p>
</statement>
    <answer>
      <p>
        <m>48</m>
      </p>
    </answer>
    <solution><me>\mathrm{Jac}(\Phi)=\frac{\partial ( x,y )}{\partial ( u,v )}=\left|\begin{array}{rr} \left(-8\right) \amp  8 \\
\left(-2\right) \amp  \left(-4\right) \end{array}\right|=\left(-8\right) \cdot \left(-4\right) -8\cdot \left(-2\right)=48</me>



</solution>
  </static>
